{
  "name": "inscription-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/prepare_deployment.mjs",
    "start": "node server.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:upstream": "node scripts/check_upstream.mjs"
  },
  "dependencies": {
    "lucide-react": "1.33.0", "openseadragon": "6.1.0",
    "react": "19.2.6", "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1", "@types/node": "22.19.19",
    "@types/openseadragon": "^5.0.2", "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3", "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1", "typescript": "5.9.3", "vite": "8.0.13"
  }
}
